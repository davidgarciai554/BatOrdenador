# BatOrdenador — configuración. Copia este fichero a `.env` y rellénalo.
# Después de cambiarlo: docker compose up -d --force-recreate

# ============================================================================
# OBLIGATORIO
# ============================================================================

# La dirección EXACTA con la que abres BatOrdenador en el navegador, con http:// o https:// y sin
# barra al final. Varias, separadas por comas.
# Si no coincide, la página carga pero NADIE puede iniciar sesión (el servidor responde 403).
ALLOWED_ORIGINS=http://localhost:4321

# No lo cambies: es la carpeta de datos dentro del contenedor.
BATORDENADOR_DATA_DIR=/app/data

# Tu primera cuenta. Solo se usa mientras no exista ningún usuario: en el primer arranque crea un
# administrador con estos datos y después ya no hace nada.
# La contraseña: al menos 12 caracteres; una frase que recuerdes vale. Si es demasiado floja el
# servidor la rechaza y lo dice en el registro (docker compose logs).
# Cuando hayas entrado, cambia la contraseña desde la app y BORRA estas dos líneas.
BATORDENADOR_ADMIN_USER=
BATORDENADOR_ADMIN_PASSWORD=

# ============================================================================
# SI LO ABRES POR HTTPS (recomendado, y necesario fuera de casa)
# ============================================================================

# Ponlo a 1 cuando entres por https://. Con http:// déjalo comentado o no podrás iniciar sesión.
#FORCE_SECURE_COOKIES=1

# ============================================================================
# HERMES — el agente con el que hablas en el chat (opcional)
# ============================================================================
# Sin esto todo lo demás funciona; el chat y la gestión de perfiles, no.

# El panel de Hermes y una cuenta suya. La app entra con ella para listar perfiles y conectarse.
#HERMES_DASHBOARD_URL=http://hermes:43827
#HERMES_DASHBOARD_USER=
#HERMES_DASHBOARD_PASSWORD=

# La dirección por la que HERMES llega a BatOrdenador. Si Hermes corre en otro contenedor de esta
# misma máquina, mételos en la misma red de Docker y usa el nombre de este contenedor:
#HERMES_MCP_URL=http://batordenador:4321/mcp

# Perfil de Hermes de tu primera cuenta. Por defecto, `default`, el que trae Hermes.
#BATORDENADOR_ADMIN_HERMES_PROFILE=default

# ============================================================================
# OPCIONAL
# ============================================================================

# Notificaciones push. No hace falta tocar nada: el servidor se genera sus claves en el primer
# arranque y las guarda en la carpeta de datos. Solo si quieres que los servicios de push puedan
# avisarte de un problema, pon aquí un contacto tuyo:
#VAPID_SUBJECT=mailto:tu-correo@example.com

# Notas de voz en el chat. Necesita un servidor wyoming-whisper. Sin él, el micrófono no aparece.
#WHISPER_HOST=
#WHISPER_PORT=10300
#WHISPER_LANGUAGE=es

# Zona horaria de los recordatorios cuando el aparato no dice la suya.
#BATORDENADOR_DEFAULT_TZ=Europe/Madrid

# Pantalla «Servicios» (experimental, solo administradores): estado de tus contenedores a través
# de Portainer.
#SERVICIOS_PORTAINER_URL=
#SERVICIOS_PORTAINER_API_KEY=
